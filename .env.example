# Required
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# Optional (defaults shown)
ACCESS_TOKEN_DAYS=30
COOKIE_SECURE=false      # must be true in production (HTTPS)
DB_ECHO=false            # log every SQL query
PUZZLE_EPOCH=2026-09-21  # date of puzzle #1

# Only needed to run the test suite
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname_test